{
  "name": "nahaquatic",
  "version": "1.0.0",
  "private": true,
  "description": "NahAquatic — Maritime Intelligence C2 Platform",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
